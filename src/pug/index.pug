        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js')

        // Slow masthead video and stop at end
        script.
            (function() {
                var v = document.getElementById('masthead-video');
                if (!v) return;
                v.playbackRate = 0.4;
                v.addEventListener('loadedmetadata', function () { v.playbackRate = 0.4; });
            })();

        // Build mailto links from data attributes to avoid plain-text scraping
        script.
            (function() {
                document.querySelectorAll('a.email-link').forEach(function(a) {
                    var u = (a.getAttribute('data-u1') || '') + (a.getAttribute('data-u2') || '');
                    var d = (a.getAttribute('data-d1') || '') + '.' + (a.getAttribute('data-d2') || '');
                    if (!u || !d) return;
                    var addr = u + '\u0040' + d;
                    a.setAttribute('href', 'mailto:' + addr);
                    var t = a.querySelector('.email-text');
                    if (t) t.textContent = addr;
                });
            })();

